<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>DlgBeatsDlg</class>
 <widget class="QWidget" name="DlgBeatsDlg">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>576</width>
    <height>400</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Beat Detection Preferences</string>
  </property>
  <layout class="QGridLayout" name="gridLayout">
   <item row="0" column="0">
    <widget class="QCheckBox" name="checkBoxAnalyzerEnabled">
     <property name="toolTip">
      <string>When beat detection is enabled, Mixxx detects the beats per minute and beats of your tracks,
automatically shows a beat-grid for them, and allows you to synchronize tracks using their beat information.</string>
     </property>
     <property name="text">
      <string>Enable BPM and Beat Detection</string>
     </property>
    </widget>
   </item>
   <item row="5" column="0">
    <spacer name="verticalSpacer">
     <property name="orientation">
      <enum>Qt::Vertical</enum>
     </property>
     <property name="sizeHint" stdset="0">
      <size>
       <width>20</width>
       <height>40</height>
      </size>
     </property>
    </spacer>
   </item>
   <item row="3" column="0">
    <widget class="QGroupBox" name="groupBox_2">
     <property name="title">
      <string>Analyzer Settings</string>
     </property>
     <layout class="QVBoxLayout" name="verticalLayout">
      <item>
       <widget class="QCheckBox" name="checkBoxFixedTempo">
        <property name="toolTip">
         <string>Converts beats detected by the analyzer into a fixed-tempo beatgrid.
Use this setting if your tracks have a constant tempo (e.g. most electronic music).
Often results in higher quality beatgrids, but will not do well on tracks that have tempo shifts.</string>
        </property>
        <property name="text">
         <string>Assume constant tempo (Recommended)</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QCheckBox" name="checkBoxFastAnalysis">
        <property name="toolTip">
         <string>Enable fast beat detection.
If activated Mixxx only analyzes the first minute of a track for beat information.
This can speed up beat detection on slower computers but may result in lower quality beatgrids.</string>
        </property>
        <property name="text">
         <string>Enable Fast Analysis (For slow computers, may be less accurate)</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QCheckBox" name="checkBoxDetectDownbeats">
        <property name="toolTip">
         <string>Find the first beat of the bar after the beat analysis.
The waveform then draws the bar lines stronger, and a controller mapping can read [ChannelN],beat_in_bar.
The detector assumes 4/4 and works best on electronic dance music.</string>
        </property>
        <property name="text">
         <string>Detect downbeats (the first beat of the bar)</string>
        </property>
       </widget>
      </item>
      <item>
       <layout class="QFormLayout" name="formLayoutDownbeatCommand">
        <item row="0" column="0">
         <widget class="QLabel" name="labelDownbeatDetector">
          <property name="text">
           <string>Downbeat detector:</string>
          </property>
         </widget>
        </item>
        <item row="0" column="1">
         <widget class="QComboBox" name="comboBoxDownbeatDetector">
          <property name="toolTip">
           <string>Which detector looks for the first beat of the bar.
The built in detector uses the audio that the beat analysis reads.
The external command runs a program on the track file. Mixxx falls back to the built in detector when the command fails.</string>
          </property>
         </widget>
        </item>
        <item row="1" column="0">
         <widget class="QLabel" name="labelDownbeatCommand">
          <property name="text">
           <string>Downbeat command:</string>
          </property>
         </widget>
        </item>
        <item row="1" column="1">
         <widget class="QLineEdit" name="lineEditDownbeatCommand">
          <property name="toolTip">
           <string>The program that finds the downbeats, with its arguments.
$INPUT is the track file. $OUTPUT is a file that the program may write; Mixxx reads the standard output when the program writes no such file.
The program must write one line for each beat, with the time in seconds and the place of the beat in its bar, and 1 for the first beat of a bar.</string>
          </property>
         </widget>
        </item>
        <item row="2" column="0">
         <widget class="QLabel" name="labelDownbeatTimeout">
          <property name="text">
           <string>Command timeout:</string>
          </property>
         </widget>
        </item>
        <item row="2" column="1">
         <widget class="QSpinBox" name="spinBoxDownbeatTimeout">
          <property name="toolTip">
           <string>Mixxx stops the program when it runs longer than this.</string>
          </property>
          <property name="suffix">
           <string> s</string>
          </property>
          <property name="minimum">
           <number>1</number>
          </property>
          <property name="maximum">
           <number>3600</number>
          </property>
         </widget>
        </item>
       </layout>
      </item>
      <item>
       <widget class="QCheckBox" name="checkBoxReanalyze">
        <property name="toolTip">
         <string>e.g. from 3rd-party programs or Mixxx versions before 1.11.
(Not checked: Analyze only, if no beats exist.)</string>
        </property>
        <property name="text">
         <string>Re-analyze beats when settings change or beat detection data is outdated</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QCheckBox" name="checkBoxReanalyzeImported">
        <property name="text">
         <string>Re-analyze beatgrids imported from other DJ software</string>
        </property>
       </widget>
      </item>
      <item>
       <layout class="QHBoxLayout" name="horizontalLayout_2">
        <item>
         <widget class="QLabel" name="labelStemStrategy">
          <property name="text">
           <string>Use rhythmic channel when analysing stem file</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QComboBox" name="comboBoxStemStrategy">
          <property name="sizePolicy">
           <sizepolicy hsizetype="Maximum" vsizetype="Fixed">
            <horstretch>0</horstretch>
            <verstretch>0</verstretch>
           </sizepolicy>
          </property>
          <item>
           <property name="text">
            <string>Disabled</string>
           </property>
          </item>
          <item>
           <property name="text">
            <string>Enforced</string>
           </property>
          </item>
         </widget>
        </item>
       </layout>
      </item>
     </layout>
    </widget>
   </item>
   <item row="2" column="0">
    <widget class="QGroupBox" name="groupBox">
     <property name="title">
      <string>Choose Analyzer</string>
     </property>
     <property name="alignment">
      <set>Qt::AlignLeading|Qt::AlignLeft|Qt::AlignTop</set>
     </property>
     <layout class="QHBoxLayout" name="horizontalLayout">
      <item>
       <widget class="QComboBox" name="comboBoxBeatPlugin">
        <property name="minimumSize">
         <size>
          <width>200</width>
          <height>0</height>
         </size>
        </property>
        <property name="maximumSize">
         <size>
          <width>2600</width>
          <height>26</height>
         </size>
        </property>
        <property name="toolTip">
         <string>Choose between different algorithms to detect beats.</string>
        </property>
        <property name="layoutDirection">
         <enum>Qt::LeftToRight</enum>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
  </layout>
 </widget>
 <layoutdefault spacing="6" margin="11"/>
 <tabstops>
  <tabstop>checkBoxAnalyzerEnabled</tabstop>
  <tabstop>comboBoxBeatPlugin</tabstop>
  <tabstop>checkBoxFixedTempo</tabstop>
  <tabstop>checkBoxReanalyze</tabstop>
  <tabstop>checkBoxReanalyzeImported</tabstop>
 </tabstops>
